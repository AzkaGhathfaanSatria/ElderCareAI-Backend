PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eldercareai"
JWT_SECRET="isi-dengan-string-acak-panjang"

# Layanan AI (Flask). Kosongkan untuk menonaktifkan AI (hanya aturan ambang detak jantung).
AI_SERVICE_URL="http://localhost:5000"

# Reset password: URL frontend untuk tautan di email, dan SMTP (opsional).
# Tanpa SMTP_HOST, isi email dicetak ke log server (kecuali NODE_ENV=production).
FRONTEND_URL="http://localhost:3000"
# SMTP_HOST=smtp.contoh.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="ElderCare AI <no-reply@contoh.com>"

# Hanya untuk development: izinkan POST /auth/register membuat admin (default: ditolak)
# ALLOW_ADMIN_REGISTER=true

# Baseline per lansia (opsional, ini nilai bawaan). Turunkan COLD_START_DAYS untuk demo/pengujian.
# BASELINE_COLD_START_DAYS=7
# BASELINE_MIN_SAMPLES=100
# BASELINE_SCHEDULER_INTERVAL_MIN=360
# BASELINE_SCHEDULER_DELAY_SEC=60
