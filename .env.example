PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eldercareai"
JWT_SECRET="isi-dengan-string-acak-panjang"

# Layanan AI (Flask). Kosongkan untuk menonaktifkan AI (hanya aturan ambang detak jantung).
AI_SERVICE_URL="http://localhost:5000"

# Reset password: URL frontend untuk tautan di email, dan SMTP (opsional).
# Tanpa SMTP_HOST, isi email dicetak ke log server (kecuali NODE_ENV=production).
FRONTEND_URL="http://localhost:3000"
# SMTP_HOST=smtp.contoh.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="ElderCare AI <no-reply@contoh.com>"

# Hanya untuk development: izinkan POST /auth/register membuat admin (default: ditolak)
# ALLOW_ADMIN_REGISTER=true

# Baseline per lansia (opsional, ini nilai bawaan). Turunkan COLD_START_DAYS untuk demo/pengujian.
# BASELINE_COLD_START_DAYS=7
# BASELINE_MIN_SAMPLES=100
# BASELINE_SCHEDULER_INTERVAL_MIN=360
# BASELINE_SCHEDULER_DELAY_SEC=60

# Kamera: password RTSP dienkripsi di database. Kunci diambil dari CAMERA_SECRET_KEY (atau JWT_SECRET bila kosong).
# CAMERA_SECRET_KEY="isi-dengan-string-acak-panjang"
# Perintah Python untuk worker kamera (default: "python" di Windows, "python3" di Linux/Docker).
# PYTHON_BIN=python

# Push notification (Firebase Cloud Messaging). Opsional: tanpa ini alert hanya masuk lewat dashboard.
# Firebase Console > Project settings > Service accounts > Generate new private key, simpan JSON di server.
# FCM_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
# (alternatif: FCM_SERVICE_ACCOUNT_JSON='{...isi JSON...}')

# Keamanan. Pembatas percobaan login/daftar/lupa password per IP.
# AUTH_LOGIN_MAX=10
# AUTH_ACCOUNT_MAX=10
# AUTH_RATE_WINDOW_MIN=15
# Batasi asal web yang boleh memanggil API (pisahkan koma). Kosong = semua asal (hanya untuk LAN/pengembangan).
# CORS_ORIGINS=http://localhost:3000,https://app.contoh.id
# Bila backend di belakang reverse proxy, isi agar IP klien terbaca benar (true atau jumlah hop, mis. 1).
# TRUST_PROXY=1
